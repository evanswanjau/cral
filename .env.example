# --- apps/api ---
NODE_ENV=development
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://cral:cral_dev_password@localhost:5432/cral_dev

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# Adapters — "console" logs instead of sending; swap to a real provider per env
SMS_ADAPTER=console
EMAIL_ADAPTER=console
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=./.local-storage

# Feature flags (comma-separated keys enabled by default in dev)
FEATURE_FLAGS=

# --- Phase 1: identity ---
# Dev-only defaults below — real secrets belong in the platform's secret
# manager before any real deploy, never committed here.
JWT_ACCESS_SECRET=dev_only_change_me_access
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# Comma-separated list of allowed browser origins. Defaults to the three
# local Vite dev ports (5173-5175) when unset — override for staging/prod.
# CORS_ORIGINS=https://merchant.cral.co.ke,https://app.cral.co.ke
