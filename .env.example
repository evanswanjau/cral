# --- apps/api ---
NODE_ENV=development
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://cral:cral_dev_password@localhost:5432/cral_dev

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# Adapters — "console" logs instead of sending; swap to a real provider per env
# "console" | "textsms". console is fine for local dev and is pinned for
# the test run; "textsms" (textsms.co.ke) is the real provider and is what
# opt-in 2FA and onboarding phone verification actually send through.
SMS_ADAPTER=console
# "console" | "smtp" | "resend". Local dev can stay on console; anything
# that needs a real verification code or reset link in an inbox wants one
# of the other two. Prefer "resend" over "smtp" where possible — raw SMTP
# to a shared/cPanel-hosted mailbox is prone to the host's IP-reputation
# firewall silently blocking whichever cloud platform you deploy to.
EMAIL_ADAPTER=console
# local = dev only (container filesystems are wiped on redeploy).
# Deployed environments must use b2.
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=./.local-storage
# Backblaze B2, S3-compatible. B2_KEY_ID must be an *application* key id
# (25 chars) - the master/account key is rejected by the S3 API.
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Feature flags (comma-separated keys enabled by default in dev)
FEATURE_FLAGS=

# --- Phase 1: identity ---
# Dev-only defaults below — real secrets belong in the platform's secret
# manager before any real deploy, never committed here.
#
# This exact placeholder is rejected at boot when NODE_ENV=production, as is
# anything under 32 characters: a committed signing key is a published one,
# and anyone reading this file could otherwise mint a token for any user id.
# Generate a real one with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=dev_only_change_me_access
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# Comma-separated list of allowed browser origins. Defaults to the three
# local Vite dev ports (5173-5175) when unset — override for staging/prod.
# The admin (Ops) console runs on 5175: if you set CORS_ORIGINS at all,
# include http://localhost:5175 or every admin call fails as an opaque
# "Failed to fetch".
# CORS_ORIGINS=https://merchant.cral.co.ke,https://app.cral.co.ke

# The customer site's own origin, for URLs GET /sitemap.xml emits.
# Defaults to the real production host when unset - override on staging.
# CUSTOMER_SITE_URL=https://staging.cral.co.ke

# --- Phase 3: admin (Ops) console ---
# Separate signing key from JWT_ACCESS_SECRET on purpose (spec §8): a leak
# of one audience's key must not mint tokens for the other. The same
# production guards apply — this exact placeholder and anything under 32
# characters are rejected at boot when NODE_ENV=production.
JWT_ADMIN_SECRET=dev_only_change_me_admin
ADMIN_ACCESS_TOKEN_TTL_MINUTES=10
# Origin of the admin console (Vite dev port), for any future links in
# admin-facing mail. Not used yet.
ADMIN_APP_URL=http://localhost:5175

# --- SMTP, required when EMAIL_ADAPTER=smtp ---
# Port 587 is STARTTLS: leave SMTP_SECURE=false. Use true only on port 465.
# Never commit the real password — it belongs in .env (gitignored) locally
# and in the platform's secret manager for staging/production.
SMTP_HOST=mail.cral.co.ke
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@cral.co.ke
SMTP_PASSWORD=
SMTP_FROM="Cruz Ride Auto <noreply@cral.co.ke>"

# --- TextSMS, required when SMS_ADAPTER=textsms ---
# textsms.co.ke bulk API. apikey + partnerID come from the account
# dashboard; shortcode is the registered sender ID. Real values belong in
# .env (gitignored) / the platform secret manager, never here.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# --- Resend, required when EMAIL_ADAPTER=resend ---
# https://resend.com — sends over HTTPS, not a raw SMTP socket, so it isn't
# subject to a mail host's firewall blocking a particular cloud platform's
# IP the way SMTP was. Requires the sending domain (cral.co.ke) to be
# verified in Resend's dashboard first (a few DNS TXT/MX records to add).
RESEND_API_KEY=
EMAIL_FROM="Cruz Ride Auto <noreply@cral.co.ke>"

# Origin of the merchant portal, used to build the password-reset link in
# the email. Must match where the built app is actually served.
MERCHANT_APP_URL=http://localhost:5174

# Where a merchant's "Query this payout" lands. CRAL's own support inbox,
# not merchant-visible — the query row is the record, this email is the
# courtesy nudge, and a delivery failure never loses the query.
PAYOUT_SUPPORT_EMAIL=support@cral.co.ke

# --- Payments: M-Pesa STK push via Cooperative Bank's gateway ---
# "console" logs an STK push instead of prompting a real phone, and is
# pinned for the test run. "coopbank" is the real rail (owner's call,
# 2026-09-11) — Co-op's WSO2 developer portal proxies Safaricom Daraja's
# STK push under their "SafaricomSTKPush" API.
#
# The request/response shape is now confirmed (2026-09-14, pulled from the
# portal's own OpenAPI document) — see the top comment in
# apps/api/src/adapters/payment/coopbank-adapter.ts. It is NOT
# Daraja-shaped: no shortcode/passkey/timestamp, just five fields Co-op's
# proxy resolves server-side against the app's own registration.
#
# COOPBANK_STK_PATH_CONFIRMED gates only that shape being right — it is
# NOT a green light for real money. How the async callback authenticates
# itself is still unconfirmed (nothing in Co-op's docs on this); do not
# flip this to "true" against production without that answer too, and
# without pointing COOPBANK_CALLBACK_URL/the portal's Callback URL at a
# reachable, real endpoint first.
PAYMENT_ADAPTER=console
COOPBANK_TOKEN_URL=https://openapi-sandbox.co-opbank.co.ke/token
COOPBANK_API_BASE_URL=https://openapi-sandbox.co-opbank.co.ke
COOPBANK_CONSUMER_KEY=
COOPBANK_CONSUMER_SECRET=
COOPBANK_CALLBACK_URL=https://api.cral.co.ke/payments/coopbank/callback
COOPBANK_STK_PATH_CONFIRMED=false
