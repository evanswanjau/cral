# --- apps/api ---
NODE_ENV=development
PORT=4000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://cral:cral_dev_password@localhost:5432/cral_dev

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# Adapters — "console" logs instead of sending; swap to a real provider per env
# "console" | "textsms". console is fine for local dev and is pinned for
# the test run; "textsms" (textsms.co.ke) is the real provider and is what
# opt-in 2FA and onboarding phone verification actually send through.
SMS_ADAPTER=console
# "console" | "smtp" | "resend". Local dev can stay on console; anything
# that needs a real verification code or reset link in an inbox wants one
# of the other two. Prefer "resend" over "smtp" where possible — raw SMTP
# to a shared/cPanel-hosted mailbox is prone to the host's IP-reputation
# firewall silently blocking whichever cloud platform you deploy to.
EMAIL_ADAPTER=console
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=./.local-storage

# Feature flags (comma-separated keys enabled by default in dev)
FEATURE_FLAGS=

# --- Phase 1: identity ---
# Dev-only defaults below — real secrets belong in the platform's secret
# manager before any real deploy, never committed here.
JWT_ACCESS_SECRET=dev_only_change_me_access
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# Comma-separated list of allowed browser origins. Defaults to the three
# local Vite dev ports (5173-5175) when unset — override for staging/prod.
# CORS_ORIGINS=https://merchant.cral.co.ke,https://app.cral.co.ke

# --- SMTP, required when EMAIL_ADAPTER=smtp ---
# Port 587 is STARTTLS: leave SMTP_SECURE=false. Use true only on port 465.
# Never commit the real password — it belongs in .env (gitignored) locally
# and in the platform's secret manager for staging/production.
SMTP_HOST=mail.cral.co.ke
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@cral.co.ke
SMTP_PASSWORD=
SMTP_FROM="Cruz Ride Auto <noreply@cral.co.ke>"

# --- TextSMS, required when SMS_ADAPTER=textsms ---
# textsms.co.ke bulk API. apikey + partnerID come from the account
# dashboard; shortcode is the registered sender ID. Real values belong in
# .env (gitignored) / the platform secret manager, never here.
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# --- Resend, required when EMAIL_ADAPTER=resend ---
# https://resend.com — sends over HTTPS, not a raw SMTP socket, so it isn't
# subject to a mail host's firewall blocking a particular cloud platform's
# IP the way SMTP was. Requires the sending domain (cral.co.ke) to be
# verified in Resend's dashboard first (a few DNS TXT/MX records to add).
RESEND_API_KEY=
EMAIL_FROM="Cruz Ride Auto <noreply@cral.co.ke>"

# Origin of the merchant portal, used to build the password-reset link in
# the email. Must match where the built app is actually served.
MERCHANT_APP_URL=http://localhost:5174
